# Run pi setup, then pi paths; edit the file shown as credentialsPath.
# Package install: ~/.config/research-pi/credentials.env by default.
# Source launcher (run-pi.sh): .env at the Research Pi checkout root.
# Fill only the providers you use. Put comments on separate lines.
# Never commit credentials or put API keys in config.json.
DEEPSEEK_API_KEY=
OPENCODE_API_KEY=
ZAI_API_KEY=
