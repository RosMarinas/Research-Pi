{
  "$schema": "./schemas/research-pi-config.schema.json",
  "version": 3,
  "pi": {
    "modelServiceTiers": {},
    "settings": {
      "theme": "research-pi",
      "tuiMode": "regular",
      "defaultTools": ["+codemode"],
      "retry": {
        "enabled": true,
        "maxRetries": 2,
        "provider": {
          "maxRetries": 0,
          "maxRetryDelayMs": 30000
        }
      },
      "compaction": {
        "enabled": true,
        "reserveTokens": 16384,
        "keepRecentTokens": 32768
      }
    }
  },
  "subagents": {
    "advisor": {
      "backend": "codex",
      "model": "gpt-5.6-sol",
      "thinking": "max",
      "speed": "inherit"
    },
    "executor": {
      "backend": "codex",
      "model": "gpt-5.6-sol",
      "thinking": "max",
      "speed": "inherit"
    },
    "environment": {
      "backend": "antigravity",
      "model": "gemini-3.1-pro-high",
      "thinking": "high"
    },
    "general": {
      "backend": "pi",
      "model": "inherit",
      "thinking": "inherit"
    }
  },
  "codex": {
    "maxExecutors": 4,
    "internalSubagent": {
      "model": "inherit",
      "thinking": "inherit"
    },
    "retention": {
      "terminalDays": 30,
      "keepTerminalJobs": 200
    }
  },
  "research": {
    "compaction": {
      "softTokens": 368640,
      "hardTokens": 393216,
      "recentTailTokens": [24576, 32768, 40960],
      "summaryTargetTokens": 8192,
      "summaryMaxTokens": 16384
    },
    "search": {
      "enabled": "off",
      "model": "deepseek-v4-flash",
      "thinkingBudgetTokens": 1024,
      "maxSources": 12,
      "defaultMaxUses": 3
    }
  },
  "resources": {
    "skills": [
      "~/.codex/skills/remote-workspace",
      "~/.agents/skills/cognitive-knowledge-network"
    ]
  },
  "ui": {
    "density": "balanced",
    "runtimeStrip": "auto",
    "configPanelRows": 8,
    "web": { "mode": "off", "persistent": true, "port": 0, "httpsPort": 8443 }
  },
  "diagnostics": {
    "trace": false,
    "codexSqliteLogs": false
  }
}
