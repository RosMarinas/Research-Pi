{
  "$schema": "./schemas/research-pi-config.schema.json",
  "version": 2,
  "pi": {
    "settings": {
      "theme": "research-pi",
      "tuiMode": "regular",
      "retry": {
        "enabled": true,
        "maxRetries": 2,
        "provider": {
          "maxRetries": 0,
          "maxRetryDelayMs": 30000
        }
      },
      "compaction": {
        "enabled": true,
        "reserveTokens": 16384,
        "keepRecentTokens": 32768
      }
    }
  },
  "codex": {
    "advisor": {
      "model": "gpt-5.6-sol",
      "reasoningEffort": "max"
    },
    "executor": {
      "model": "gpt-5.6-sol",
      "reasoningEffort": "max"
    },
    "retention": {
      "terminalDays": 30,
      "keepTerminalJobs": 200
    }
  },
  "research": {
    "compaction": {
      "softTokens": 278528,
      "hardTokens": 393216,
      "recentTailTokens": [24576, 32768, 40960],
      "summaryTargetTokens": 8192,
      "summaryMaxTokens": 16384
    },
    "search": {
      "enabled": "auto",
      "model": "deepseek-v4-flash",
      "thinkingBudgetTokens": 1024,
      "maxSources": 12,
      "defaultMaxUses": 3
    }
  },
  "resources": {
    "skills": [
      "~/.codex/skills/remote-workspace",
      "~/.agents/skills/cognitive-knowledge-network"
    ]
  },
  "ui": {
    "density": "balanced",
    "runtimeStrip": "auto",
    "configPanelRows": 8
  },
  "diagnostics": {
    "trace": false,
    "codexSqliteLogs": false
  }
}
