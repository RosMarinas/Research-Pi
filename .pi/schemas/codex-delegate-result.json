{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Research Pi Codex delegation result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "outcome",
    "goal_satisfied",
    "completion_basis",
    "summary",
    "evidence",
    "actions_taken",
    "changed_files",
    "checks",
    "external_effects",
    "uncertainties",
    "remaining_work",
    "recommended_next_step"
  ],
  "properties": {
    "outcome": {
      "type": "string",
      "enum": ["succeeded", "partial", "blocked", "failed"],
      "description": "Semantic outcome of the delegated objective, not the transport status of the Codex turn."
    },
    "goal_satisfied": {
      "type": "boolean",
      "description": "True only when the delegated objective and its success criteria are complete."
    },
    "completion_basis": {
      "type": "string",
      "maxLength": 4000,
      "description": "Why this is a legitimate final handoff rather than an intermediate progress update."
    },
    "summary": {
      "type": "string",
      "maxLength": 12000
    },
    "evidence": {
      "type": "array",
      "maxItems": 32,
      "items": { "type": "string", "maxLength": 4000 }
    },
    "actions_taken": {
      "type": "array",
      "maxItems": 64,
      "items": { "type": "string", "maxLength": 2000 }
    },
    "changed_files": {
      "type": "array",
      "maxItems": 256,
      "items": { "type": "string", "maxLength": 1024 }
    },
    "checks": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["command", "result"],
        "properties": {
          "command": { "type": "string", "maxLength": 2000 },
          "result": { "type": "string", "maxLength": 4000 }
        }
      }
    },
    "external_effects": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "target", "identifier", "detail"],
        "properties": {
          "kind": { "type": "string", "maxLength": 256 },
          "target": { "type": "string", "maxLength": 2000 },
          "identifier": { "type": "string", "maxLength": 1000 },
          "detail": { "type": "string", "maxLength": 4000 }
        }
      }
    },
    "uncertainties": {
      "type": "array",
      "maxItems": 32,
      "items": { "type": "string", "maxLength": 4000 }
    },
    "remaining_work": {
      "type": "array",
      "maxItems": 32,
      "description": "Work still inside the delegated objective. Empty when goal_satisfied is true.",
      "items": { "type": "string", "maxLength": 4000 }
    },
    "recommended_next_step": {
      "type": "string",
      "maxLength": 8000,
      "description": "The next decision or task after this delegation ends; do not use it for work that should still be completed in the current turn."
    }
  }
}
