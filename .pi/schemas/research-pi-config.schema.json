{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/RosMarinas/Research-Pi/research-pi-config.schema.json",
  "title": "Research Pi Configuration",
  "type": "object",
  "required": ["version", "activeProfile", "profiles"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "const": 1 },
    "activeProfile": { "type": "string", "minLength": 1 },
    "profiles": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": ["provider", "model", "thinking"],
        "properties": {
          "label": { "type": "string" },
          "description": { "type": "string" },
          "provider": { "type": "string", "minLength": 1 },
          "model": { "type": "string", "minLength": 1 },
          "thinking": { "enum": ["off", "minimal", "low", "medium", "high", "xhigh", "max"] }
        },
        "additionalProperties": false
      }
    },
    "pi": {
      "type": "object",
      "properties": {
        "settings": {
          "type": "object",
          "description": "Pi core settings, written to the generated internal settings.json adapter."
        }
      },
      "additionalProperties": false
    },
    "codex": { "type": "object" },
    "research": {
      "type": "object",
      "properties": {
        "compaction": {
          "type": "object",
          "required": ["softTokens", "hardTokens", "recentTailTokens", "summaryTargetTokens", "summaryMaxTokens"],
          "properties": {
            "softTokens": { "type": "integer", "minimum": 1 },
            "hardTokens": { "type": "integer", "minimum": 1 },
            "recentTailTokens": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "integer", "minimum": 1 }
            },
            "summaryTargetTokens": { "type": "integer", "minimum": 1 },
            "summaryMaxTokens": { "type": "integer", "minimum": 1 }
          },
          "additionalProperties": false
        },
        "search": {
          "type": "object",
          "properties": {
            "enabled": { "enum": ["auto", "on", "off"] },
            "model": { "type": "string", "minLength": 1 },
            "thinkingBudgetTokens": { "type": "integer", "minimum": 1 },
            "maxSources": { "type": "integer", "minimum": 1, "maximum": 50 },
            "defaultMaxUses": { "type": "integer", "minimum": 1, "maximum": 5 }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "resources": { "type": "object" },
    "ui": {
      "type": "object",
      "required": ["density", "runtimeStrip", "showProfileStatus", "configPanelRows"],
      "properties": {
        "density": { "enum": ["compact", "balanced"] },
        "runtimeStrip": { "enum": ["auto", "always", "off"] },
        "showProfileStatus": { "type": "boolean" },
        "configPanelRows": { "type": "integer", "minimum": 3, "maximum": 20 }
      },
      "additionalProperties": false
    },
    "diagnostics": { "type": "object" },
    "providerCompat": { "type": "object" }
  },
  "additionalProperties": false
}
