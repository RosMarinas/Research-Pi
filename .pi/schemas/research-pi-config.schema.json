{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/RosMarinas/Research-Pi/research-pi-config.schema.json",
  "title": "Research Pi Configuration",
  "type": "object",
  "required": ["version"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "const": 2 },
    "pi": {
      "type": "object",
      "properties": {
        "settings": {
          "type": "object",
          "description": "Pi core settings, written to the generated internal settings.json adapter."
        }
      },
      "additionalProperties": false
    },
    "codex": {
      "type": "object",
      "required": ["advisor", "executor", "retention"],
      "properties": {
        "advisor": { "$ref": "#/$defs/codexRole" },
        "executor": { "$ref": "#/$defs/codexRole" },
        "retention": {
          "type": "object",
          "required": ["terminalDays", "keepTerminalJobs"],
          "properties": {
            "terminalDays": { "type": "integer", "minimum": 1 },
            "keepTerminalJobs": { "type": "integer", "minimum": 1 }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "research": {
      "type": "object",
      "properties": {
        "compaction": {
          "type": "object",
          "required": ["softTokens", "hardTokens", "recentTailTokens", "summaryTargetTokens", "summaryMaxTokens"],
          "properties": {
            "softTokens": { "type": "integer", "minimum": 1 },
            "hardTokens": { "type": "integer", "minimum": 1 },
            "recentTailTokens": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "integer", "minimum": 1 }
            },
            "summaryTargetTokens": { "type": "integer", "minimum": 1 },
            "summaryMaxTokens": { "type": "integer", "minimum": 1 }
          },
          "additionalProperties": false
        },
        "search": {
          "type": "object",
          "properties": {
            "enabled": { "enum": ["auto", "on", "off"] },
            "model": { "type": "string", "minLength": 1 },
            "thinkingBudgetTokens": { "type": "integer", "minimum": 1 },
            "maxSources": { "type": "integer", "minimum": 1, "maximum": 50 },
            "defaultMaxUses": { "type": "integer", "minimum": 1, "maximum": 5 }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "resources": { "type": "object" },
    "ui": {
      "type": "object",
      "required": ["density", "runtimeStrip", "configPanelRows"],
      "properties": {
        "density": { "enum": ["compact", "balanced"] },
        "runtimeStrip": { "enum": ["auto", "always", "off"] },
        "configPanelRows": { "type": "integer", "minimum": 3, "maximum": 20 }
      },
      "additionalProperties": false
    },
    "diagnostics": { "type": "object" }
  },
  "additionalProperties": false,
  "$defs": {
    "codexRole": {
      "type": "object",
      "required": ["model", "reasoningEffort"],
      "properties": {
        "model": { "type": "string", "minLength": 1 },
        "reasoningEffort": { "enum": ["low", "medium", "high", "xhigh", "max", "ultra"] }
      },
      "additionalProperties": false
    }
  }
}
