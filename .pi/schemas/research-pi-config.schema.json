{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/RosMarinas/Research-Pi/research-pi-config.schema.json",
  "title": "Research Pi Configuration",
  "type": "object",
  "required": ["version"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "const": 3 },
    "pi": {
      "type": "object",
      "properties": {
        "modelServiceTiers": {
          "type": "object",
          "description": "Per-model Leader speed, keyed by provider/model. Native Pi owns model and thinking defaults.",
          "additionalProperties": { "enum": ["inherit", "standard", "fast"] }
        },
        "settings": {
          "type": "object",
          "description": "Pi core settings, written to the generated internal settings.json adapter."
        }
      },
      "additionalProperties": false
    },
    "subagents": {
      "type": "object",
      "required": ["advisor", "executor", "environment", "general"],
      "properties": {
        "advisor": { "$ref": "#/$defs/runner" },
        "executor": { "$ref": "#/$defs/runner" },
        "environment": { "$ref": "#/$defs/runner" },
        "general": { "$ref": "#/$defs/runner" }
      },
      "additionalProperties": false
    },
    "codex": {
      "type": "object",
      "required": ["internalSubagent", "retention"],
      "properties": {
        "internalSubagent": {
          "type": "object",
          "required": ["model", "thinking"],
          "properties": {
            "model": { "type": "string", "minLength": 1 },
            "thinking": { "enum": ["inherit", "none", "minimal", "low", "medium", "high", "xhigh", "max", "ultra"] }
          },
          "additionalProperties": false
        },
        "maxExecutors": { "type": "integer", "minimum": 1, "description": "Concurrent executors per workspace; writing scopes must not overlap." },
        "retention": {
          "type": "object",
          "required": ["terminalDays", "keepTerminalJobs"],
          "properties": {
            "terminalDays": { "type": "integer", "minimum": 1 },
            "keepTerminalJobs": { "type": "integer", "minimum": 1 }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "research": {
      "type": "object",
      "properties": {
        "compaction": {
          "type": "object",
          "required": ["softTokens", "hardTokens", "summaryTargetTokens", "summaryMaxTokens"],
          "properties": {
            "softTokens": { "type": "integer", "minimum": 1 },
            "hardTokens": { "type": "integer", "minimum": 1 },
            "recentTailTokens": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "integer", "minimum": 1 },
              "deprecated": true,
              "description": "Compatibility data for already-running pre-cleanup readers of config.defaults.json. Current readers strip it; use pi.settings.compaction.keepRecentTokens."
            },
            "summaryTargetTokens": { "type": "integer", "minimum": 1 },
            "summaryMaxTokens": { "type": "integer", "minimum": 1 }
          },
          "additionalProperties": false
        },
        "search": {
          "type": "object",
          "properties": {
            "enabled": { "enum": ["auto", "on", "off"] },
            "model": { "type": "string", "minLength": 1 },
            "thinkingBudgetTokens": { "type": "integer", "minimum": 1 },
            "maxSources": { "type": "integer", "minimum": 1, "maximum": 50 },
            "defaultMaxUses": { "type": "integer", "minimum": 1, "maximum": 5 }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "resources": { "type": "object" },
    "ui": {
      "type": "object",
      "required": ["density", "runtimeStrip", "configPanelRows"],
      "properties": {
        "density": { "enum": ["compact", "balanced"] },
        "runtimeStrip": { "enum": ["auto", "always", "off"] },
        "configPanelRows": { "type": "integer", "minimum": 3, "maximum": 20 }
      },
      "additionalProperties": false
    },
    "diagnostics": { "type": "object" }
  },
  "additionalProperties": false,
  "$defs": {
    "runner": {
      "type": "object",
      "required": ["backend", "model", "thinking"],
      "properties": {
        "backend": { "enum": ["codex", "antigravity", "pi"] },
        "model": { "type": "string", "minLength": 1 },
        "thinking": { "enum": ["inherit", "off", "none", "minimal", "low", "medium", "high", "xhigh", "max", "ultra"] },
        "speed": { "enum": ["inherit", "standard", "fast"] }
      },
      "additionalProperties": false
    }
  }
}
