{
  "defaultProvider": "deepseek",
  "defaultModel": "deepseek-v4-flash",
  "defaultThinkingLevel": "max",
  "enabledModels": [
    "deepseek/deepseek-v4-flash:max"
  ],
  "sessionDir": ".pi/sessions",
  "retry": {
    "enabled": true,
    "maxRetries": 2,
    "provider": {
      "maxRetries": 0,
      "maxRetryDelayMs": 30000
    }
  },
  "compaction": {
    "enabled": true,
    "reserveTokens": 16384,
    "keepRecentTokens": 32768
  }
}
