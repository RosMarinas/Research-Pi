{
  "name": "@rosmarinas/research-pi",
  "version": "0.2.0",
  "type": "module",
  "description": "Research-first Pi harness for AI and communications experiments",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/RosMarinas/Research-Pi.git"
  },
  "bin": {
    "pi": "bin/pi.mjs",
    "pi-traced": "bin/pi-traced.mjs",
    "pi-raw": "bin/pi-raw.mjs"
  },
  "files": [
    "bin/",
    ".pi/APPEND_SYSTEM.md",
    ".pi/config.defaults.json",
    ".pi/extensions/",
    ".pi/lib/",
    ".pi/skills/",
    ".pi/schemas/",
    ".pi/themes/",
    ".pi/vendor/",
    "docs/pi-basic-guide.md",
    "docs/configuration.md",
    "docs/cache-diagnostics.md",
    "docs/pi-1-migration.md",
    "docs/research-runtime-test-guide.md",
    "docs/security-model.md",
    ".env.example",
    "README.md",
    "README_en.md",
    "SECURITY.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "web/",
    "docs/mobile-web.md",
    "docs/native-ui-runtime-boundary.md",
    "docs/subagent-conversations.md",
    "integrations/vscode-terminal/",
    "scripts/package-vscode-terminal.py",
    "scripts/prepare-web.mjs",
    "scripts/check.mjs",
    "scripts/test-windows-native.mjs",
    "docs/windows-powershell-guide.md"
  ],
  "scripts": {
    "pi": "node bin/pi.mjs",
    "pi:trace": "node bin/pi-traced.mjs",
    "check": "node scripts/check.mjs",
    "check:package": "node scripts/verify-package.mjs",
    "prepack": "npm run check && npm run check:package",
    "setup:web": "node scripts/prepare-web.mjs",
    "postinstall": "node scripts/prepare-web.mjs",
    "test:windows": "node scripts/test-windows-native.mjs"
  },
  "engines": {
    "node": ">=22.19"
  },
  "dependencies": {
    "@anthropic-ai/sandbox-runtime": "0.0.71",
    "@anthropic-ai/sdk": "0.91.1",
    "@earendil-works/pi-ai": "1.2.0",
    "@earendil-works/pi-coding-agent": "1.2.0",
    "@earendil-works/pi-tui": "1.2.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-serialize": "0.14.0",
    "@xterm/headless": "6.0.0",
    "@xterm/xterm": "6.0.0",
    "dompurify": "3.4.16",
    "marked": "18.0.14",
    "node-pty": "1.1.0",
    "typebox": "1.3.7",
    "ws": "8.22.0"
  }
}
